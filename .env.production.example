# Production environment — templates only (no real secrets). Copy values from server/.env.

# Live deploy
# Store:  https://twoside-store.pages.dev
# API:    https://twoside-store-api.alihamiehlb.workers.dev

# --- GitHub Actions (build-time) ---
VITE_API_URL=
VITE_CDN_URL=
VITE_WHATSAPP_NUMBER=
# VITE_TURNSTILE_SITE_KEY=

# GitHub secret: CLOUDFLARE_API_TOKEN
# GitHub variable or env: CLOUDFLARE_ACCOUNT_ID=fc8761363df4a7a310cc35ed41d1c809

# --- Cloudflare Worker secrets (wrangler — scripts/sync-wrangler-secrets.ps1) ---
# MONGODB_URI=
# REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379
# JWT_SECRET=
# CSRF_SECRET=
# CORS_ORIGIN=https://twoside-store.pages.dev
# CLIENT_URL=https://twoside-store.pages.dev
# ADMIN_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://twoside-store.pages.dev/api/auth/google/callback
# WHATSAPP_NUMBER=
# TURNSTILE_SECRET_KEY=
# PAYMENT_MODE=mock

# --- Payments (when Whish merchant approved) ---
# PAYMENT_MODE=live
# WHISH_MERCHANT_ID=
# WHISH_API_KEY=
# WHISH_API_URL=https://api.whish.money/v1
# WHISH_WEBHOOK_SECRET=

# --- R2 (main image store) — run scripts/setup-r2.ps1 ---
# R2_ACCOUNT_ID=fc8761363df4a7a310cc35ed41d1c809
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=twoside-store-assets
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# VITE_CDN_URL=https://pub-xxxx.r2.dev
