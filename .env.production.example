# Production environment — set in Cloudflare Worker secrets + GitHub Actions

# GitHub secret (build-time only)
VITE_API_URL=https://api.yourdomain.com

# Worker secrets (wrangler secret put — see infrastructure/CLOUDFLARE-CICD.md)
# MONGODB_URI=
# REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379
# JWT_SECRET=
# CSRF_SECRET=
# CORS_ORIGIN=https://yourdomain.com
# CLIENT_URL=https://yourdomain.com
# ADMIN_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# R2 (when image upload is wired)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=twoside-store-assets
# R2_PUBLIC_URL=https://assets.yourdomain.com
