# Production environment — set in Cloudflare Worker secrets + GitHub Actions

# Live deploy (2026-06-06)
# Store:  https://twoside-store.pages.dev
# API:    https://twoside-store-api.alihamiehlb.workers.dev

# GitHub secret (build-time) — leave empty for same-origin /api proxy
VITE_API_URL=
# VITE_TURNSTILE_SITE_KEY=   # GitHub secret — Cloudflare Turnstile site key (production widget)

# Cloudflare account ID (GitHub secret CLOUDFLARE_ACCOUNT_ID)
# Set in GitHub Actions as CLOUDFLARE_ACCOUNT_ID — never commit the value here

# Worker secrets (wrangler — see scripts/sync-wrangler-secrets.ps1)
# MONGODB_URI=
# REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379
# JWT_SECRET=
# CSRF_SECRET=
# CORS_ORIGIN=https://yourdomain.com
# CLIENT_URL=https://yourdomain.com
# ADMIN_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://twoside-store.pages.dev/api/auth/google/callback
# WHATSAPP_NUMBER=96176666666
# TURNSTILE_SECRET_KEY=   # Cloudflare Turnstile → Dashboard > Turnstile > your widget > Secret key

# R2 (when image upload is wired)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=twoside-store-assets
# R2_PUBLIC_URL=https://assets.yourdomain.com
