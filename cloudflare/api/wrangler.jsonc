{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "twoside-store-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "TwosideServer",
      "image": "../../server/Dockerfile",
      "max_instances": 5,
      "rollout_step_percentage": [10, 100]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TWOSIDE_SERVER",
        "class_name": "TwosideServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TwosideServer"]
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
